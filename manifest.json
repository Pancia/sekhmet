{
    "manifest_version": 2,
    "name": "Sekhmet",
    "description": "Gates the feeds that eat attention - YouTube, openfront.io - behind a hold, plus downloads and a feeling tracker",
    "version": "1.0",
    "key": "",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        },
        "default_title": "Sekhmet - gate wallpapers"
    },
    "browser_specific_settings": {
        "gecko": {
            "strict_min_version": "54.0a1"
        }
    },
    "background": {
        "scripts": ["polyfill.js", "background.js"]
    },
    "permissions": ["storage", "unlimitedStorage", "tabs", "contextMenus", "nativeMessaging"],
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["polyfill.js", "lib.js", "ytdl.js", "overlays.js", "feeling-tracker.js", "volume.js", "loop.js", "youtube.js", "index.js"],
            "all_frames": false
        },
        {
            "matches": ["*://*.duckduckgo.com/*"],
            "js": ["polyfill.js", "lib.js", "google-it.js"],
            "all_frames": false
        },
        {
            "matches": ["*://openfront.io/*", "*://*.openfront.io/*"],
            "js": ["polyfill.js", "lib.js", "overlays.js", "openfront-gate.js"],
            "run_at": "document_end",
            "all_frames": false
        },
        {
            "matches": ["*://watch.thechosen.tv/*"],
            "js": ["polyfill.js", "lib.js", "thechosen.js"],
            "run_at": "document_end",
            "all_frames": false
        }
    ],
    "web_accessible_resources": ["player-bridge.js", "wallpaper.html"],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}
