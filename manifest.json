{
    "manifest_version": 2,
    "name": "Sekhmet",
    "description": "Gates the feeds that eat attention - YouTube, openfront.io - behind a hold, plus downloads and a feeling tracker",
    "version": "1.0",
    "key": "",
    "browser_specific_settings": {
        "gecko": {
            "strict_min_version": "54.0a1"
        }
    },
    "background": {
        "scripts": ["polyfill.js", "background.js"]
    },
    "permissions": ["storage", "tabs", "contextMenus", "nativeMessaging"],
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["polyfill.js", "lib.js", "ytdl.js", "overlays.js", "feeling-tracker.js", "volume.js", "youtube.js", "index.js"],
            "all_frames": false
        },
        {
            "matches": ["*://*.duckduckgo.com/*"],
            "js": ["polyfill.js", "lib.js", "google-it.js"],
            "all_frames": false
        },
        {
            "matches": ["*://openfront.io/*", "*://*.openfront.io/*"],
            "js": ["polyfill.js", "lib.js", "overlays.js", "openfront-gate.js"],
            "run_at": "document_end",
            "all_frames": false
        }
    ],
    "web_accessible_resources": ["player-bridge.js"]
}
